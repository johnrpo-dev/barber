# /etc/villa/villa.env: secretos de villa-web y villa-worker en el VPS.
#   sudo install -m 0600 -o root -g root /root/villa-kit/deploy/env/villa.env.example /etc/villa/villa.env
#   sudo nano /etc/villa/villa.env
# systemd lo lee como root antes de soltar privilegios: el usuario villa NO puede leer el archivo.
# NODE_ENV, HOSTNAME y PORT los ponen las unidades systemd; no van aquí.
# Nunca subas este archivo con valores al repositorio. Genera cada secreto con:
#   openssl rand -base64 48

# Rol villa_app (src/db/roles/setup-roles.sql). Sin DDL ni UPDATE/DELETE sobre el libro.
DATABASE_URL=postgres://villa_app:CAMBIAR@localhost:5432/villa

APP_TIMEZONE=America/Bogota
APP_CURRENCY=COP

# better-auth. NO se rota a la ligera: cifra los TOTP y firma sesiones (docs/arquitectura.md).
# Guarda una copia sellada fuera del VPS, junto con la llave privada de los backups.
BETTER_AUTH_SECRET=CAMBIAR
BETTER_AUTH_URL=https://reservas.TU-DOMINIO.co

# Reserva pública: dos secretos DISTINTOS de 32+ caracteres.
OTP_PEPPER=CAMBIAR
MANAGE_LINK_SECRET=CAMBIAR
PUBLIC_BASE_URL=https://reservas.TU-DOMINIO.co

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CAMBIAR
TURNSTILE_SECRET=CAMBIAR

# WhatsApp Cloud API
WHATSAPP_TOKEN=CAMBIAR
WHATSAPP_PHONE_NUMBER_ID=CAMBIAR
WHATSAPP_APP_SECRET=CAMBIAR

# Resend (correo): avisos a clientes y avisos de seguridad/cuota al dueño (ALERT_EMAIL)
RESEND_API_KEY=CAMBIAR
EMAIL_FROM="Villa Barbería <citas@TU-DOMINIO.co>"
ALERT_EMAIL=dueno@TU-DOMINIO.co

NOTIFY_CAP_PHONE=6
NOTIFY_CAP_GLOBAL=300

# CSP de scripts. false = solo reporta (registro "[csp]"): la semana de prueba y la vuelta atrás.
# Al terminar la semana, borra esta línea: en producción, sin ella, bloquea. Ver docs/despliegue.md.
CSP_ENFORCE=false
