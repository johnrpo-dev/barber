# /etc/villa/backup.env  (sudo install -m 0600 -o root -g root backup.env.example /etc/villa/backup.env)
# Lo lee systemd como root antes de pasar al usuario postgres. Sin secretos de la app aquí. Las
# llaves del bucket viven en RCLONE_CONFIG; la llave privada de age NO va en este archivo.

VILLA_DB=villa
BACKUP_DIR=/var/backups/villa

# Llave PÚBLICA de age (age1...). Puedes poner dos: la tuya y la de un respaldo (contador, socio).
# root:postgres 0640: postgres la lee y no la puede cambiar por otra.
AGE_RECIPIENTS_FILE=/etc/villa/backup-recipients.txt

# rclone: remoto configurado con `sudo rclone config --config /etc/villa/rclone.conf`.
# postgres:postgres 0600. La llave del bucket que va ahí NO debe poder borrar.
RCLONE_CONFIG=/etc/villa/rclone.conf
# Backblaze B2: "b2:NOMBRE-DEL-BUCKET"   ·   Cloudflare R2: "r2:NOMBRE-DEL-BUCKET"
RCLONE_REMOTE=b2:villa-backups-CAMBIAR

# Retención: la hacen las reglas de ciclo de vida del bucket (docs/despliegue.md, "Bucket").
# Solo si no puedes usar reglas: PRUNE_FROM_VPS=1, con una llave de bucket que sí pueda borrar. Quien
# tome el VPS podría entonces destruir los backups.
PRUNE_FROM_VPS=0
# KEEP_DAILY_DAYS=7
# KEEP_WEEKLY_DAYS=28
# KEEP_MONTHLY_DAYS=366

# Prueba mensual de restauración: SOLO si decides dejar la llave privada en el VPS (ver
# docs/despliegue.md, "Custodia de las llaves"). Si no, déjala comentada y apaga el timer.
# AGE_IDENTITY_FILE=/etc/villa/backup-identity.txt

# Opcional: "dead man's switch" (healthchecks.io u otro). Si no llega el ping, te avisan.
# HEALTHCHECK_URL=https://hc-ping.com/CAMBIAR
# RESTORE_HEALTHCHECK_URL=https://hc-ping.com/CAMBIAR
# Opcional: a dónde avisar cuando algo falla (ntfy, webhook propio).
# ALERT_WEBHOOK_URL=https://ntfy.sh/CAMBIAR-tema-secreto
