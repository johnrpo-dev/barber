# Prueba de restauración mensual (deploy/backup/villa-restore-test.sh): baja el último backup,
# lo restaura en una base temporal, corre las pruebas de cordura del libro y la borra.
[Unit]
Description=Villa: prueba mensual de restauración del backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
OnFailure=villa-alert@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/villa-restore-test.sh
EnvironmentFile=/etc/villa/backup.env
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/backups/villa
