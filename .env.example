# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL 18 local: base y rol "villa"
DATABASE_URL=postgres://villa:CAMBIAR@localhost:5432/villa

# Sede por defecto
APP_TIMEZONE=America/Bogota
APP_CURRENCY=COP

# better-auth (solo personal: dueño, recepción, barbero)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Reserva pública (sprint 3) ───────────────────────────────────────────────
# Todo es opcional: sin estas variables el panel funciona igual. Fuera de desarrollo, si falta un
# secreto, Turnstile o WhatsApp (el código sale SOLO por WhatsApp), /reservar muestra "Reserva por
# teléfono". Solo con NODE_ENV=development o test se usan secretos fijos, el verificador falso y la
# consola; con cualquier otro NODE_ENV (incluso sin definir, p. ej. el worker) falla cerrado.

# Secretos de 32 caracteres o más, DISTINTOS entre sí (p. ej. `openssl rand -base64 48`).
# OTP_PEPPER firma los códigos y las cubetas de límites; MANAGE_LINK_SECRET, los enlaces /cita.
OTP_PEPPER=
MANAGE_LINK_SECRET=
# URL pública del portal; en producción debe ser https://
PUBLIC_BASE_URL=http://localhost:3000

# Cloudflare Turnstile (en staging, las claves de prueba de Cloudflare)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# WhatsApp Cloud API (obligatorio para la reserva en línea): número aprobado y plantillas en "es"
# (ver docs/sprint-3-reserva-publica.md §9)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Correo con Resend (dominio verificado): avisos y recordatorios, nunca el código.
# ALERT_EMAIL recibe el aviso al 80 % de la cuota diaria (los códigos cuentan en ella).
RESEND_API_KEY=
EMAIL_FROM="Villa Barbería <citas@tu-dominio.com>"
ALERT_EMAIL=

# Cuotas de envío por día (opcionales): por destinatario y globales por sede
NOTIFY_CAP_PHONE=6
NOTIFY_CAP_GLOBAL=300
