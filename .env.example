# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL 18 local: base y rol "villa"
DATABASE_URL=postgres://villa:CAMBIAR@localhost:5432/villa

# Sede por defecto
APP_TIMEZONE=America/Bogota
APP_CURRENCY=COP

# better-auth (solo personal: dueño, recepción, barbero)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# WhatsApp Cloud API (sprint 3)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
